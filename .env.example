# Fabula — copia questo file in `.env` e riempi i valori.
# Il `.env` non va mai su Git.

# ---------------------------------------------------------------- database
POSTGRES_USER=fabula
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=fabula
POSTGRES_PORT=5432

# In sviluppo punta al container `db` esposto su localhost.
DATABASE_URL="postgresql://fabula:cambiami@localhost:5432/fabula"

# --------------------------------------------------------------- accessi
APP_PORT=3000

# L'indirizzo pubblico da cui si raggiunge la piattaforma.
# Serve per costruire i link dentro alle email e per accettare l'accesso.
# In sviluppo Vite serve sulla 5173; in produzione va il dominio del tunnel.
APP_URL="http://localhost:5173"

# Token del connettore Cloudflare Tunnel (Zero Trust → Networks → Tunnels →
# il tunnel → Configure → token). Lascia vuoto se non usi il tunnel.
CLOUDFLARE_TUNNEL_TOKEN=""

# Chiave di firma delle sessioni. Generane una con:
#   openssl rand -base64 32
SESSION_SECRET=""

# Accesso con Google. Lascia vuoto per disattivarlo: restano codice OTP e password.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Accesso con l'account dell'università. Lascia vuoto per disattivarlo.
# Si registra l'applicazione su https://entra.microsoft.com → Applicazioni →
# Registrazioni app → Nuova registrazione:
#   - tipi di account: «Solo account in questa directory organizzativa», che è
#     il valore predefinito e quello giusto qui;
#   - URI di reindirizzamento, tipo «Web»:
#       http://localhost:5173/api/auth/callback/microsoft   (sviluppo)
#       https://IL-TUO-DOMINIO/api/auth/callback/microsoft   (produzione)
#   - il segreto si crea in «Certificati e segreti» e si vede **una volta sola**;
#     ha una scadenza, segnatela.
# Utile ma non obbligatorio: in «Configurazione token» aggiungere le pretese
# facoltative `email` e `email_verified`, così l'indirizzo arriva sempre.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
#
# **Il GUID della directory in cui l'applicazione è registrata** («ID
# directory (tenant)» nella pagina Panoramica). Va messo: un'applicazione
# registrata per una sola organizzazione — il valore predefinito — non può
# usare l'endpoint condiviso, e Microsoft risponde `AADSTS50194`.
# Lasciarlo vuoto significa `common`, che funziona solo se l'applicazione è
# stata dichiarata multi-organizzazione al momento della registrazione.
# Quello di unibz è 92513267-03e3-401a-80d4-c58ed6674e3b (vale per unibz.it,
# scientificnet.org ed education.unibz.it).
MICROSOFT_TENANT_ID=""

# ------------------------------------------------------------------ email
# https://resend.com — gratuito fino a 3.000 email al mese.
# Il dominio del mittente va verificato su Resend prima di poter spedire:
# https://resend.com/docs/dashboard/domains/introduction
RESEND_API_KEY=""
EMAIL_FROM="Fabula <noreply@fabulabz.com>"

# Gli indirizzi **in più** a cui mandare le nuove richieste, separati da
# virgola: la casella condivisa dell'associazione, o chi vuole l'avviso senza
# avere un account. Gli admin veri non stanno qui — si leggono dal database,
# ciascuno sul canale che ha scelto. Un indirizzo di questa lista che
# corrisponde a un admin registrato viene scartato, o chi ha scelto «solo
# notifiche» continuerebbe a ricevere la posta dalla porta di servizio.
ADMIN_EMAILS=""

# -------------------------------------------------------- notifiche push
# Le chiavi VAPID con cui il server firma le notifiche. Si generano una volta
# sola, e poi non si toccano più:
#
#   pnpm exec node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# **Rigenerarle scollega tutti i dispositivi, tutti insieme e senza avviso**:
# ogni iscrizione esistente diventa carta straccia e ognuno deve riattivare le
# notifiche a mano dal proprio profilo. Vanno nel backup accanto a
# SESSION_SECRET — vedi il capitolo *Backup* di CLAUDE.md.
#
# Lasciarle vuote non rompe niente: le notifiche restano spente e tutti gli
# avvisi partono via email, che è esattamente il comportamento di prima.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Un recapito di chi gestisce il servizio. Lo pretende lo standard: se le
# notifiche di Fabula diventassero un problema, è qui che Google o Mozilla
# scriverebbero prima di chiudere il rubinetto.
VAPID_SUBJECT="mailto:tu@example.com"

# ------------------------------------------------------ produzione: Coolify
#
# In produzione questo file non esiste. Le variabili qui sopra si incollano
# nel pannello dell'applicazione in Coolify, che le inietta nell'ambiente del
# container — ed è la ragione per cui il `.dockerignore` tiene il `.env`
# fuori dall'immagine: in produzione non ce n'è uno da leggere.
#
# **Tre non si incollano a mano:**
#
#   DATABASE_URL   la scrive Coolify, collegando l'applicazione alla risorsa
#                  Postgres del progetto. Punta al nome del container del
#                  database sulla rete interna, mai a localhost.
#   POSTGRES_*     non servono: il database non è più un servizio del
#                  `docker-compose.yml`, che in produzione non si usa più.
#   APP_PORT       non serve: nessuna porta è esposta sull'host. Il tunnel
#                  vive nella stessa rete Docker e parla al container per
#                  nome, `http://fabula:3000`.
#
# `APP_URL` invece va messo a mano ed è il dominio pubblico vero: da lì
# nascono i link dentro alle email e gli indirizzi di ritorno dell'accesso.
# Sbagliarlo non rompe niente in modo visibile — semplicemente le email
# portano nel posto sbagliato.
#
# `CLOUDFLARE_TUNNEL_TOKEN` non sta nell'applicazione ma sulla **risorsa
# `cloudflared`**, che è un container a parte: è lui a usarlo, non Fabula.
